---
import '../styles/global.css';
// 背景あしらい（素材ベース）。素材の変換は scripts/build-deco-parts.py
import '../styles/deco-parts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description = SITE.description, ogImage = '/assets/images/ogp.png' } = Astro.props;
const pageTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜長崎のAIシステム開発・AI相談・Web制作`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// ローカルビジネス構造化データ（Web検索・AI検索の両対応の要）
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  alternateName: 'まちのAI',
  description: SITE.description,
  url: Astro.site?.toString(),
  address: {
    '@type': 'PostalAddress',
    addressRegion: '長崎県',
    addressLocality: '長崎市',
  },
  areaServed: '長崎県',
  knowsAbout: ['AI活用支援', 'AIセミナー', '生成AI研修', 'ホームページ制作', 'Web保守'],
};

// サイト名の構造化データ。検索エンジンに「まちのAI＝このサイトの略称」を機械的に伝える
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: 'まちのAI',
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-740PJ5K47G"></script>
    <script is:inline>
      // 内部トラフィックの除外。/?noga=1 を一度開いたブラウザは以後計測しない（/?noga=0 で解除）。
      // 本番ドメイン以外（ローカル確認・github.io）も計測しない
      try {
        var noga = new URLSearchParams(location.search).get('noga');
        if (noga === '1') localStorage.setItem('machino-ai-noga', '1');
        if (noga === '0') localStorage.removeItem('machino-ai-noga');
        if (localStorage.getItem('machino-ai-noga') === '1' || location.hostname !== 'machino-ai.jp') {
          window['ga-disable-G-740PJ5K47G'] = true;
        }
      } catch (e) {}
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-740PJ5K47G');
      // LINE友だち追加リンクのクリックを計測（リンク先が lin.ee なら発火）
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href*="lin.ee"]');
        if (a) gtag('event', 'line_click', { link_url: a.href });
      });
    </script>
    <!-- スクロール演出用。JSが動く環境だけ要素を隠すので、ここで先に印を付ける（表示のちらつき防止） -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/images/logo-mark.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <!-- OGP -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- フォント -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Klee+One:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSite)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- スクロールに合わせて、各ブロックを下からふわっと出す。
         ファーストビュー（hero・page-header・記事タイトル）は対象外にして、表示速度を落とさない。
         新しいセクションを足したときは、下の TARGETS に足すか、要素に data-reveal を付ける -->
    <script is:inline>
      (function () {
        var TARGETS = [
          '.section-title',
          '.point-card',
          '.case-card',
          '.promise-card',
          '.service-card',
          '.service-featured img',
          '.service-featured__body',
          '.work-card',
          '.price-card',
          '.flow-card',
          '.blog-card',
          '.faq-item',
          '.profile__photo',
          '.profile__body',
          '.ranking',
          '.cases__hook',
          '.article-body img',
          '.cta-section .container > *',
          '[data-reveal]',
        ].join(',');

        // 出方の指定。ここに載らないものは、カードなら reveal--card、それ以外は素の上がり方
        var VARIANTS = [
          ['.section-title', 'reveal--title'],
          ['.profile__photo', 'reveal--left'],
          ['.service-featured img', 'reveal--left'],
          ['.profile__body', 'reveal--right'],
          ['.service-featured__body', 'reveal--right'],
        ];

        function variantOf(el) {
          for (var v = 0; v < VARIANTS.length; v++) {
            if (el.matches(VARIANTS[v][0])) return VARIANTS[v][1];
          }
          return null;
        }

        var items = Array.prototype.slice.call(document.querySelectorAll(TARGETS));
        if (!items.length) return;

        // 見出しが先、そのあとカードが左から順に。同時に出ると「順番に出てきた感」が消える
        items.forEach(function (el) {
          var parent = el.parentElement;
          var i = 0;
          if (parent) {
            i = parent.revealCount || 0;
            parent.revealCount = i + 1;
          }
          var variant = variantOf(el);
          // container 直下＝見出しなどは即スタート、カードの並びは見出しの後を追う
          var isCard = !variant && !!(parent && !parent.classList.contains('container'));
          var delay = (isCard ? 0.15 : 0) + Math.min(i, 5) * 0.1;
          if (delay) el.style.setProperty('--reveal-delay', delay.toFixed(2) + 's');
          el.classList.add('reveal');
          if (variant) el.classList.add(variant);
          else if (isCard) el.classList.add('reveal--card');
        });

        function revealAll() {
          items.forEach(function (el) {
            el.classList.add('is-revealed');
          });
        }

        // IntersectionObserver が無い / 画面の高さが取れない環境（headlessのキャプチャ等）では
        // 隠れたままにならないよう、最初から全部出しておく
        if (!('IntersectionObserver' in window) || !window.innerHeight) {
          revealAll();
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            });
          },
          // 要素が12%見えて、かつ画面に15%入ってから動き出す。
          // 画面の端で動き終わってしまうと「気づかない」ので、少し内側で始める
          { rootMargin: '0px 0px -15% 0px', threshold: 0.12 }
        );

        items.forEach(function (el) {
          io.observe(el);
        });

        // ページ末尾は22%の線まで上がりきらないことがあるので、
        // 最下部まで来たら残りを必ず出す（読めない要素を作らないための保険）
        window.addEventListener(
          'scroll',
          function () {
            var doc = document.documentElement;
            if (window.scrollY + window.innerHeight >= doc.scrollHeight - 4) revealAll();
          },
          { passive: true }
        );
      })();
    </script>

    <!-- スクロールし始めたらヘッダーに影を付ける -->
    <script is:inline>
      (function () {
        var header = document.querySelector('.header');
        if (!header) return;

        function update() {
          header.classList.toggle('is-scrolled', window.scrollY > 24);
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
