---
import Base from '../layouts/Base.astro';
import CtaSection from '../components/CtaSection.astro';
---

<Base
  title="制作実績"
  description="まちのAI屋さんのWeb制作実績。長崎の中小企業・個人事業主のホームページ制作をお手伝いしています。"
>
  <div class="page-header">
    <div class="container">
      <h1>制作実績</h1>
      <p>長崎の事業者さまのホームページを<span class="nb">お手伝いしています</span></p>
    </div>
  </div>

  <section class="section dp dp--frame dp--hatch">
    <div class="container">
      <div class="works">
        <div class="work-card">
          <div class="work-card__frame">
            <img src="/assets/images/works-ohama.webp" alt="大浜畳商店様 ホームページ制作実績" loading="lazy" />
          </div>
          <div class="work-card__body">
            <h3>大浜畳商店 様</h3>
            <a href="https://ohama-tatami.co.jp/" target="_blank" rel="noopener">サイトを見る →</a>
            <!-- TODO: 掲載許可済みの一言コメント取得後に work-card__voice を追加 -->
          </div>
        </div>
        <div class="work-card">
          <div class="work-card__frame">
            <img src="/assets/images/works-nakahira.webp" alt="中平個人タクシー様 ホームページ制作実績" loading="lazy" />
          </div>
          <div class="work-card__body">
            <h3>中平個人タクシー 様</h3>
            <a href="https://nagasaki-nakahira-taxi.jp/" target="_blank" rel="noopener">サイトを見る →</a>
          </div>
        </div>
      </div>
      <!-- TODO: 中野さん（立鳶工業）の匿名掲載OKが出たら、下のコメントを外して有効化する。画像は架空データのデモ版（2026-09-05作成） -->
      <!--
      <div class="section-title" style="margin-top:48px">
        <span class="section-title__sub">AIシステム・業務ツール</span>
        <h2>業務ツールの<span class="nb">制作実績</span></h2>
      </div>
      <div class="works">
        <div class="work-card">
          <div class="work-card__frame">
            <img src="/assets/images/works-seikyusho-excel.webp" alt="請求書管理Excelの目次画面（会社名・金額は架空のデモ）" loading="lazy" />
          </div>
          <div class="work-card__body">
            <h3>請求書管理Excel（長崎市内の鳶工事業者 様）</h3>
            <p class="work-card__voice">毎月20社ぶんの請求書を1つのExcelに。日付を1ヶ所入れて、明細を入れて、チェックして出すだけ。</p>
            <a href="/blog/seikyusho-excel-story/">くわしい事例を読む →</a>
          </div>
        </div>
      </div>
      -->
      <!-- 将来拡張: インタビュー形式の詳しい事例記事はコラム（caseカテゴリ）に追加していく -->
    </div>
  </section>

  <CtaSection />
</Base>
