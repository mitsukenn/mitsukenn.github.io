---
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import { CATEGORIES } from '../../config';
import { ALL_TERMS } from '../../data/glossary';
import { getCollection } from 'astro:content';

const TERM_COUNT = ALL_TERMS.length;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// キーワード検索用: タイトル・説明・カテゴリ・本文をテキスト化して埋め込む
const stripMd = (s: string) =>
  s
    .replace(/<!--[\s\S]*?-->/g, ' ')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>*`|]+/g, ' ')
    .replace(/\s+/g, ' ');

const searchData = posts.map((p) =>
  [p.data.title, p.data.description, CATEGORIES[p.data.category], stripMd(p.body ?? '')]
    .join(' ')
    .normalize('NFKC')
    .toLowerCase()
);
---

<Base
  title="コラム"
  description="長崎の中小企業のためのAI活用コラム。ChatGPTなどのAIツールの使い方、補助金情報、導入事例を、専門用語を使わずにお届けします。"
>
  <div class="page-header">
    <div class="container">
      <h1>コラム</h1>
      <p>長崎の中小企業のための、やさしいAI活用情報</p>
    </div>
  </div>

  <section class="section dp dp--frame dp--diagonal">
    <div class="container">
      <a href="/ai-yougo/" class="yougo-promo">
        <span class="yougo-promo__label">辞典</span>
        <span class="yougo-promo__body">
          <b>AI用語辞典（{TERM_COUNT}語）</b>
          ニュースで見かけるAIの言葉を、専門用語なしで1ページにまとめました。
        </span>
        <span class="yougo-promo__arrow" aria-hidden="true">→</span>
      </a>

      <div class="blog-search">
        <input
          type="search"
          id="blog-search-input"
          placeholder="キーワードで記事を探す（補助金、議事録 など）"
          aria-label="記事をキーワード検索"
          autocomplete="off"
        />
        <p id="blog-search-count" class="blog-search__count" hidden></p>
      </div>

      <div class="blog-list">
        {
          posts.map((post, i) => (
            <a href={`/blog/${post.id}/`} class="blog-card" data-i={i}>
              {post.data.heroImage && (
                <img class="blog-card__thumb" src={post.data.heroImage} alt="" loading="lazy" />
              )}
              <span class="blog-card__cat">{CATEGORIES[post.data.category]}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection />

  <script type="application/json" id="blog-search-data" set:html={JSON.stringify(searchData)} />
  <script>
    const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const countEl = document.getElementById('blog-search-count');
    const dataEl = document.getElementById('blog-search-data');
    if (input && countEl && dataEl) {
      const data: string[] = JSON.parse(dataEl.textContent || '[]');
      const cards = [...document.querySelectorAll<HTMLElement>('.blog-card[data-i]')];
      input.addEventListener('input', () => {
        const words = input.value
          .normalize('NFKC')
          .toLowerCase()
          .split(/[\s　]+/)
          .filter(Boolean);
        let hits = 0;
        for (const card of cards) {
          const text = data[Number(card.dataset.i)] || '';
          const ok = words.every((w) => text.includes(w));
          card.style.display = ok ? '' : 'none';
          if (ok) hits++;
        }
        if (words.length === 0) {
          countEl.hidden = true;
        } else {
          countEl.hidden = false;
          countEl.textContent =
            hits > 0 ? `${hits}件見つかりました` : '見つかりませんでした。別の言葉でもう一度どうぞ';
        }
      });
    }
  </script>

  <style>
    .blog-search {
      margin: 0 0 20px;
    }
    .blog-search input {
      width: 100%;
      padding: 12px 16px;
      font-size: 16px;
      font-family: inherit;
      color: inherit;
      background: #fff;
      border: 2px solid var(--accent);
      border-radius: 10px;
    }
    .blog-search input::placeholder {
      color: #9aa5b1;
    }
    .blog-search input:focus {
      outline: none;
      border-color: var(--accent-dark);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }
    .blog-search__count {
      margin: 8px 2px 0;
      font-size: 14px;
      color: #5d6b7a;
    }
  </style>
</Base>
