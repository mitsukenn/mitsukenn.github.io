---
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import { CATEGORIES, SITE } from '../../config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 関連記事: 同カテゴリの最新3件（自分自身を除く）
const related = (await getCollection('blog', ({ data, id }) => !data.draft && id !== post.id))
  .filter((p) => p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const pageUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const imageUrl = post.data.heroImage
  ? new URL(post.data.heroImage, Astro.site).href
  : new URL('/assets/images/ogp.png', Astro.site).href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: [imageUrl],
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  url: pageUrl,
  inLanguage: 'ja',
  articleSection: CATEGORIES[post.data.category],
  isAccessibleForFree: true,
  author: {
    '@type': 'Person',
    name: '新垣 充生',
    jobTitle: 'AI活用アドバイザー',
    worksFor: { '@type': 'Organization', name: SITE.name, url: Astro.site?.href },
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: Astro.site?.href,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/assets/images/logo-mark.png', Astro.site).href,
    },
  },
};

// パンくず（検索結果に階層を出す）
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: new URL('/blog/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
  ],
};
---

<Base title={post.data.title} description={post.data.description} ogImage={post.data.ogImage}>
  <section class="section section--article dp dp--header">
    <div class="container article">
      <header class="article__header">
        <span class="blog-card__cat">{CATEGORIES[post.data.category]}</span>
        <h1>{post.data.title}</h1>
        <p class="article__meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        </p>
      </header>
      {post.data.heroImage && <img class="article__hero" src={post.data.heroImage} alt="" />}
      <div class="article-body">
        <Content />
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--soft dp dp--target dp--hatch">
        <div class="container">
          <div class="section-title">
            <h2>関連記事</h2>
          </div>
          <div class="blog-list">
            {related.map((p) => (
              <a href={`/blog/${p.id}/`} class="blog-card">
                {p.data.heroImage && (
                  <img class="blog-card__thumb" src={p.data.heroImage} alt="" loading="lazy" />
                )}
                <span class="blog-card__cat">{CATEGORIES[p.data.category]}</span>
                <h3>{p.data.title}</h3>
                <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <!-- コードブロック（プロンプト例など）にコピーボタンを付ける -->
  <script is:inline>
    document.querySelectorAll('.article-body pre').forEach(function (pre) {
      var wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = 'コピー';
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(pre.innerText.trim()).then(function () {
          btn.textContent = 'コピーしました ✓';
          btn.classList.add('is-copied');
          setTimeout(function () {
            btn.textContent = 'コピー';
            btn.classList.remove('is-copied');
          }, 2000);
        });
      });
      wrap.appendChild(btn);
    });
  </script>

  <!-- 「□ 」で始まる太字行をチェックできるようにする（状態はこの端末に保存） -->
  <script is:inline>
    (function () {
      var items = [];
      document.querySelectorAll('.article-body p > strong').forEach(function (s) {
        if (s.parentNode.childNodes.length === 1 && s.textContent.trim().indexOf('□') === 0) items.push(s);
      });
      if (!items.length) return;

      var KEY = 'checklist:' + location.pathname;
      var saved = {};
      try {
        saved = JSON.parse(localStorage.getItem(KEY) || '{}');
      } catch (e) {}

      // 各項目の「（目安は◯分が◯分に）」から時短分数を読み、見出しから分野を拾う
      var NEXT_STEP = {
        '①': { label: 'ChatGPTの始め方', href: '/blog/chatgpt-hajimekata/' },
        '②': { label: '議事録AIの記事', href: '/blog/gijiroku-ai-jidouka/' },
        '③': { label: 'Excel管理表をアプリにする記事', href: '/blog/excel-kanrihyou-app-ka/' },
      };
      var meta = items.map(function (s) {
        var p = s.parentNode;
        var body = p.nextElementSibling && p.nextElementSibling.tagName === 'P' ? p.nextElementSibling.textContent : '';
        var m = body.match(/目安は([^）]*)/);
        var before = 0;
        var after = 0;
        if (m) {
          var nums = m[1].match(/(\d+)\s*(時間|分)/g) || [];
          if (nums.length >= 2) {
            var toMin = function (x) {
              var n = parseInt(x, 10);
              return x.indexOf('時間') >= 0 ? n * 60 : n;
            };
            before = toMin(nums[0]);
            after = toMin(nums[nums.length - 1]);
          }
        }
        var head = p;
        var section = '';
        while ((head = head.previousElementSibling)) {
          if (head.tagName === 'H2') {
            section = head.textContent.trim().charAt(0);
            break;
          }
        }
        return {
          label: s.textContent.trim().replace(/^□\s*/, ''),
          before: before,
          after: after,
          section: section,
        };
      });

      function fmt(min) {
        if (min < 60) return min + '分';
        var h = Math.floor(min / 60);
        var m2 = min % 60;
        return m2 ? h + '時間' + m2 + '分' : h + '時間';
      }

      var result = document.createElement('div');
      result.className = 'check-result';
      result.hidden = true;
      var lastBody = items[items.length - 1].parentNode.nextElementSibling || items[items.length - 1].parentNode;
      lastBody.parentNode.insertBefore(result, lastBody.nextSibling);

      function renderResult(doneIdx) {
        if (!doneIdx.length) {
          result.hidden = true;
          return;
        }
        result.hidden = false;
        var before = 0;
        var after = 0;
        var counted = 0;
        var top = null;
        doneIdx.forEach(function (i) {
          var d = meta[i];
          if (d.before && d.after) {
            before += d.before;
            after += d.after;
            counted++;
            if (!top || d.before - d.after > top.before - top.after) top = d;
          }
        });
        var saveMin = before - after;
        var skipped = doneIdx.length - counted;
        var html = '<h3>チェックした' + doneIdx.length + '個で分かること</h3>';
        if (counted) {
          html +=
            '<p class="check-result__lead">1回ぶんを合計すると <b>' +
            fmt(before) +
            ' が ' +
            fmt(after) +
            '</b>。<br>それぞれ週1回起きるとして、ひと月でおよそ <b>' +
            fmt(saveMin * 4) +
            '</b> が浮く計算です。</p>' +
            '<p class="check-result__note">記事に書いた目安をそのまま足しただけの、ざっくりした計算です。' +
            (skipped ? '数字で出しにくい' + skipped + '個は入れていません。' : '') +
            '</p>';
        } else {
          html +=
            '<p class="check-result__lead">チェックした項目は、時間の目安を数字で出しにくいものでした。ただ、抜け漏れや手戻りが減るぶんの効きめは大きいところです。</p>';
        }
        if (!top) top = meta[doneIdx[0]];
        if (top) {
          var step = NEXT_STEP[top.section] || NEXT_STEP['①'];
          html +=
            '<p class="check-result__next"><b>次の1つは「' +
            top.label +
            '」から。</b><br>' +
            (counted ? 'チェックした中でいちばん時間が浮くのがここです。' : '') +
            'まずこれだけをAIに任せてみてください。やり方は「<a href="' +
            step.href +
            '">' +
            step.label +
            '</a>」に書いています。</p>';
        }
        result.innerHTML = html;
      }

      var counter = document.createElement('p');
      counter.className = 'check-progress';
      var count = document.createElement('span');
      var reset = document.createElement('button');
      reset.type = 'button';
      reset.className = 'check-reset';
      reset.textContent = 'ぜんぶ外す';
      counter.appendChild(count);
      counter.appendChild(reset);
      items[0].parentNode.parentNode.insertBefore(counter, items[0].parentNode);

      function refresh() {
        var doneIdx = [];
        items.forEach(function (s, i) {
          if (s.parentNode.classList.contains('is-done')) doneIdx.push(i);
        });
        count.textContent = 'チェック ' + doneIdx.length + ' / ' + items.length;
        counter.classList.toggle('is-all', doneIdx.length === items.length);
        renderResult(doneIdx);
      }

      items.forEach(function (s, i) {
        var p = s.parentNode;
        s.textContent = s.textContent.replace(/^□\s*/, '');
        var box = document.createElement('span');
        box.className = 'check-box';
        s.insertBefore(box, s.firstChild);
        p.className = 'check-item';
        p.setAttribute('role', 'button');
        p.setAttribute('tabindex', '0');
        if (saved[i]) p.classList.add('is-done');
        p.setAttribute('aria-pressed', saved[i] ? 'true' : 'false');

        function toggle() {
          var on = p.classList.toggle('is-done');
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
          saved[i] = on;
          try {
            localStorage.setItem(KEY, JSON.stringify(saved));
          } catch (e) {}
          refresh();
        }
        p.addEventListener('click', toggle);
        p.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle();
          }
        });
      });

      reset.addEventListener('click', function () {
        items.forEach(function (s, i) {
          s.parentNode.classList.remove('is-done');
          s.parentNode.setAttribute('aria-pressed', 'false');
          saved[i] = false;
        });
        try {
          localStorage.setItem(KEY, JSON.stringify(saved));
        } catch (e) {}
        refresh();
      });

      refresh();
    })();
  </script>

  <CtaSection />
</Base>
